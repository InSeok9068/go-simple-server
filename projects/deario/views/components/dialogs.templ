package components

import "fmt"

templ CbtDialog() {
	<dialog id="cbt-dialog" class="max">
		<h5>CBT 인지행동치료</h5>
		<p class="bold">CBT 일기</p>
		<ul class="list no-space">
			<li>
				1. 자동생각 : 떠오른 그대로 보기
				<br/>
				✅ 이 정도로는 부족해, 더 잘해야 인정받지
			</li>
			<li>
				2. 생각검토 : 사실 vs 내가 만든 기준
				<br/>
				✅ 이건 진짜 사실인가, 내가 만든 기준인가?
			</li>
			<li>
				3. 새로운생각 : 현실적으로 균형잡기
				<br/>
				✅ 이미 잘 해오고 있고, 지금도 과정 중이다
			</li>
			<li>
				4. 감정다루기 : 없애지 말고 흘려보내기
				<br/>
				✅ 불안이 올라왔네, 그냥 지나가게 두자
			</li>
		</ul>
		<hr/>
		<nav></nav>
		<p class="bold">대화 자기 점검</p>
		<ul class="list no-space">
			<li>
				감정 인정: 상대 감정을 충분히 받아줬는가
				<br/>
				👉 많이 힘들었겠네
			</li>
			<li>
				숨은 의도: 말 뒤의 감정/이유를 짐작해봤는가
				<br/>
				👉 혹시 피곤해서 더 예민했던 걸까?
			</li>
			<li>
				판단/변명: 내 입장보다 먼저 인정했는가
				<br/>
				👉 네가 서운했겠네. 미안해 (감정 먼저)
			</li>
		</ul>
		<nav class="right-align">
			<button class="surface-variant" type="button" data-ui="#cbt-dialog">닫기</button>
		</nav>
	</dialog>
}

templ AiFeedbackDialog(date string, hasAIData bool) {
	<dialog id="ai-feedback-dialog" class="max">
		<h5>일기 요정</h5>
		<form
			hx-post="/ai-feedback/save?"
			hx-swap="none"
			data-deario-after="ai-feedback:saved"
		>
			<input type="hidden" name="date" value={ date }/>
			<div id="ai-feedback-content">
				<div id="ai-feedback-markdown"></div>
				<textarea name="ai-feedback" hidden></textarea>
			</div>
			<nav class="right-align">
				@AiFeedbackDeleteButton(date, !hasAIData)
				<button type="submit">
					<i>save</i>
					<span>저장</span>
				</button>
				<button type="button" class="surface-variant" data-ui="#ai-feedback-dialog">닫기</button>
			</nav>
		</form>
	</dialog>
}

templ AiFeedbackDeleteButton(date string, hidden bool) {
	<button
		id="ai-feedback-delete-action"
		class="error"
		type="button"
		hidden?={ hidden }
		hx-delete="/ai-feedback"
		hx-swap="none"
		hx-confirm="저장된 일기요정을 삭제할까요?"
		hx-vals={ fmt.Sprintf("{\"date\":\"%s\"}", date) }
		data-deario-after="ai-feedback:deleted"
	>
		<i>delete</i>
		<span>삭제</span>
	</button>
}

templ CalendarDialog(date string) {
	<dialog id="calendar-dialog" class="bottom">
		<h5>달력</h5>
		<div class="space"></div>
		<div id="calendar-picker"></div>
		<nav class="right-align">
			<button class="surface-variant" type="button" data-ui="#calendar-dialog">닫기</button>
		</nav>
	</dialog>
}

templ DiaryImageDialog(date string) {
	<dialog id="diary-image-dialog" class="bottom">
		<h5>이미지</h5>
		<div hx-get={ fmt.Sprintf("/diary/images?date=%s", date) } hx-trigger="load"></div>
		<div class="space"></div>
		<button>
			<i>attach_file</i>
			File
			<input type="file" accept="image/*" id="diary-image-file" data-deario-image-preview/>
		</button>
		<nav class="right-align">
			<img id="diary-image-loading" src="/shared/static/spinner.svg" style="display:none" alt="로딩"/>
			<button type="button" data-deario-image-upload data-date={ date }>업로드</button>
			<button class="surface-variant" type="button" data-ui="#diary-image-dialog">닫기</button>
		</nav>
	</dialog>
}

templ DiaryListDialog() {
	<dialog id="diary-list-dialog" class="max">
		<h5>작성 일지</h5>
		<ul id="diary-list-content" class="border list"></ul>
		<div x-data="{ page : 1 }">
			<nav class="center-align">
				<button
					hx-get="/diary/list"
					hx-target="#diary-list-content"
					hx-trigger="load delay:0.5s, click"
					hx-swap="beforeend"
					@click="page++"
					:hx-vals="JSON.stringify({ page: page })"
				>
					<i>arrow_drop_down</i>
				</button>
			</nav>
			<nav class="right-align">
				<button class="surface-variant" type="button" data-ui="#diary-list-dialog">닫기</button>
			</nav>
		</div>
	</dialog>
}

templ MenuDialog() {
	<dialog id="menu-dialog" class="right">
		<h5>메뉴</h5>
		<ul class="list">
			<li class="wave round">
				<a href="/statistic">
					<i>monitoring</i>
					통계
				</a>
			</li>
			<li class="wave round">
				<a href="/setting">
					<i>settings</i>
					설정
				</a>
			</li>
			<li class="wave round">
				<a href="/privacy">
					<i>admin_panel_settings</i>
					개인정보 처리방침
				</a>
			</li>
		</ul>
		<nav class="right-align">
			<button class="surface-variant" type="button" data-ui="#menu-dialog">닫기</button>
		</nav>
	</dialog>
}
