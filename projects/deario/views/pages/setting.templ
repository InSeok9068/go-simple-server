package pages

import (
	"fmt"

	"simple-server/projects/deario/db"
	"simple-server/projects/deario/views/layout"
	shared "simple-server/shared/views"
)

templ Setting(userSetting db.UserSetting) {
	<!DOCTYPE html>
	<html lang="ko">
		<head>
			@shared.HeadsWithBeer("설정")
			@shared.HeadsWithFirebaseAuth()
			@shared.HeadsWithGoogleFonts("Gamja Flower", "Gowun Dodum", "Sunflower:wght@300;500;700", "Jua", "Diphylleia")
			<link rel="manifest" href="/manifest.json"/>
			<script src="/static/deario.js"></script>
			<script src="/static/app_lock.js"></script>
		</head>
		<body>
			@shared.Snackbar()
			@layout.AppHeader()
			<main class="responsive">
				<form hx-post="/setting" hx-swap="none" data-deario-after="toast" data-deario-message="저장 되었습니다.">
					<fieldset>
						<legend>설정</legend>
						<nav>알림</nav>
						<label class="switch">
							if userSetting.IsPush == 1 {
								<input type="checkbox" name="is_push" value="1" checked/>
							} else {
								<input type="checkbox" name="is_push" value="1"/>
							}
							<span></span>
						</label>
						<div class="border field label">
							<input type="time" name="push_time" value={ userSetting.PushTime }/>
							<label>알림시간</label>
						</div>
						<div class="border field label">
							<input type="number" name="random_range" value={ fmt.Sprintf("%d", userSetting.RandomRange) }/>
							<label>랜덤일자</label>
						</div>
						<nav>앱 잠금</nav>
						if userSetting.AppLockEnabled == 1 {
							<div class="chip primary">
								<i>lock</i>
								<span>PIN 잠금 켜짐</span>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="current_pin"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>현재 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>새 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin_confirm"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>PIN 확인</label>
							</div>
							<nav class="right-align">
								<button type="submit" form="app-lock-pin-form">
									<i>vpn_key</i>
									<span>PIN 변경</span>
								</button>
							</nav>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="current_pin"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-disable-form"
								/>
								<label>현재 PIN</label>
							</div>
							<nav class="right-align">
								<button type="submit" class="surface-variant" form="app-lock-disable-form">
									<i>lock_open</i>
									<span>잠금 끄기</span>
								</button>
							</nav>
						} else {
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>새 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin_confirm"
									inputmode="numeric"
									pattern="[0-9]*"
									minlength="4"
									maxlength="6"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>PIN 확인</label>
							</div>
							<nav class="right-align">
								<button type="submit" form="app-lock-pin-form">
									<i>lock</i>
									<span>잠금 켜기</span>
								</button>
							</nav>
						}
						<nav>테마</nav>
						<label class="switch icon">
							<input type="checkbox" x-data="" x-bind:checked="$store.theme.value === 'dark'" x-on:change="$store.theme.toggle()"/>
							<span>
								<i>dark_mode</i>
							</span>
						</label>
						<nav>테마색</nav>
						<div class="border field label">
							<button>
								<i>palette</i>
								<span>Color</span>
								<input
									type="color"
									x-data=""
									x-model="$store.theme.color"
									x-on:change="$store.theme.setColor($event.target.value)"
								/>
							</button>
						</div>
						<nav>폰트</nav>
						<div class="border field label">
							<select x-data="" x-model="$store.font.value" x-on:change="$store.font.set($event.target.value)">
								<option value="gamja">감자꽃 (기본)</option>
								<option value="gowun_dodum">고운돋움</option>
								<option value="sunflower">해바라기</option>
								<option value="jua">주아</option>
								<option value="diphylleia">디필레아</option>
								<option value="humanist">따뜻한 휴머니스트</option>
								<option value="neo_grotesque">깔끔한 모던 산세리프</option>
								<option value="monospace_code">코드 느낌 모노스페이스</option>
								<option value="industrial">빈티지 인더스트리얼</option>
								<option value="rounded_sans">동글동글 라운드 산세리프</option>
							</select>
							<label>폰트</label>
						</div>
						<nav class="right-align">
							<button>저장</button>
						</nav>
					</fieldset>
				</form>
				<form id="app-lock-pin-form" hx-post="/app-lock/pin" hx-swap="none"></form>
				<form id="app-lock-disable-form" hx-post="/app-lock/disable" hx-swap="none"></form>
			</main>
		</body>
	</html>
}
