package pages

import (
	"fmt"

	"simple-server/projects/deario/db"
	"simple-server/projects/deario/views/layout"
	shared "simple-server/shared/views"
)

templ Setting(userSetting db.UserSetting) {
	<!DOCTYPE html>
	<html lang="ko">
		<head>
			@shared.HeadsWithBeer("설정")
			@shared.HeadsWithFirebaseAuth()
			@shared.HeadsWithGoogleFonts("Noto Sans KR:wght@100..900", "Noto Serif KR:wght@100..900", "Gowun Dodum", "Gowun Batang:wght@400;700", "Hahmlet:wght@100..900")
			<link rel="manifest" href="/manifest.json"/>
			<script src="/static/deario.js"></script>
			<script src="/static/app_lock.js"></script>
		</head>
		<body>
			@shared.Snackbar()
			@layout.AppHeader()
			<main class="responsive deario-settings-page">
				<form hx-post="/setting" hx-swap="none" data-deario-after="toast" data-deario-message="저장 되었습니다.">
					<fieldset>
						<legend>설정</legend>
						<nav>알림</nav>
						<label class="switch">
							if userSetting.IsPush == 1 {
								<input type="checkbox" name="is_push" value="1" checked/>
							} else {
								<input type="checkbox" name="is_push" value="1"/>
							}
							<span></span>
						</label>
						<div class="border field label">
							<input type="time" name="push_time" value={ userSetting.PushTime }/>
							<label>알림시간</label>
						</div>
						<div class="border field label">
							<input type="number" name="random_range" value={ fmt.Sprintf("%d", userSetting.RandomRange) }/>
							<label>랜덤일자</label>
						</div>
						<nav>앱 잠금</nav>
						if userSetting.AppLockEnabled == 1 {
							<div class="chip primary">
								<i>lock</i>
								<span>PIN 잠금 켜짐</span>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="current_pin"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>현재 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>새 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin_confirm"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>PIN 확인</label>
							</div>
							<nav class="right-align">
								<button type="submit" form="app-lock-pin-form">
									<i>vpn_key</i>
									<span>PIN 변경</span>
								</button>
							</nav>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="current_pin"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-disable-form"
								/>
								<label>현재 PIN</label>
							</div>
							<nav class="right-align">
								<button type="submit" class="surface-variant" form="app-lock-disable-form">
									<i>lock_open</i>
									<span>잠금 끄기</span>
								</button>
							</nav>
						} else {
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>새 PIN</label>
							</div>
							<div class="border field label">
								<input
									class="pin-mask-input"
									type="text"
									name="pin_confirm"
									inputmode="numeric"
									pattern="[0-9]*"
									autocomplete="off"
									autocorrect="off"
									spellcheck="false"
									enterkeyhint="done"
									style="-webkit-text-security: disc;"
									form="app-lock-pin-form"
								/>
								<label>PIN 확인</label>
							</div>
							<nav class="right-align">
								<button type="submit" form="app-lock-pin-form">
									<i>lock</i>
									<span>잠금 켜기</span>
								</button>
							</nav>
						}
						<nav>테마</nav>
						<label class="switch icon">
							<input type="checkbox" x-data="" x-bind:checked="$store.theme.value === 'dark'" x-on:change="$store.theme.toggle()"/>
							<span>
								<i>dark_mode</i>
							</span>
						</label>
						<nav>테마색</nav>
						<div class="border field label">
							<button>
								<i>palette</i>
								<span>Color</span>
								<input
									type="color"
									x-data=""
									x-model="$store.theme.color"
									x-on:change="$store.theme.setColor($event.target.value)"
								/>
							</button>
						</div>
						<nav>폰트</nav>
						<div class="border field label">
							<select x-data="" x-model="$store.font.value" x-on:change="$store.font.set($event.target.value)">
								<option value="pretendard">프리텐다드 (기본)</option>
								<option value="noto_sans_kr">Noto Sans KR</option>
								<option value="nanum_square_round">나눔스퀘어라운드 (둥글고 친근한 UI)</option>
								<option value="gowun_dodum">고운돋움 (부드럽고 따뜻한 UI)</option>
								<option value="gmarket_sans">G마켓 산스 (활기 있고 정돈된 느낌)</option>
								<option value="noto_serif_kr">Noto Serif KR</option>
								<option value="gowun_batang">고운바탕 (차분한 일기 본문)</option>
								<option value="hahmlet">Hahmlet (감성적인 일기장)</option>
							</select>
							<label>폰트</label>
						</div>
						<nav class="right-align">
							<button>저장</button>
						</nav>
					</fieldset>
				</form>
				<form id="app-lock-pin-form" hx-post="/app-lock/pin" hx-swap="none"></form>
				<form id="app-lock-disable-form" hx-post="/app-lock/disable" hx-swap="none"></form>
			</main>
		</body>
	</html>
}
